{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "api/index.py"
    },
    {
      "src": "/css/(.*)",
      "dest": "/css/"
    },
    {
      "src": "/js/(.*)",
      "dest": "/js/"
    },
    {
      "src": "/(.*)",
      "dest": "/"
    }
  ]
}